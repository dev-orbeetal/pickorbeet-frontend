PORT=3777

# Local: point at Django directly.
# Production (same-domain via Vercel rewrites): use the public site paths.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8777/api/v1
NEXT_PUBLIC_ADMIN_URL=http://127.0.0.1:8777/admin
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3777
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Used by next.config.js rewrites to proxy /api /admin /static /media
# to Django. Leave empty for local make up. On Vercel set e.g.:
# BACKEND_ORIGIN=https://admin.pickorbeet.com
BACKEND_ORIGIN=

# Server-only. Must match the API ANALYTICS_INGEST_SECRET.
# The browser never receives this. On Vercel, set the same value as Django.
ANALYTICS_INGEST_SECRET=
